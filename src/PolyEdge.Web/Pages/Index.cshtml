@page
<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>PolyEdge | Paper Trading</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/>
<style>
:root{--bg:#0b1020;--panel:#121a2c;--line:#25314a;--muted:#91a0ba;--text:#e8eef9;--green:#24c78a;--red:#ff647c;--blue:#6ea8fe}
body{background:var(--bg);color:var(--text);font-family:Inter,system-ui,sans-serif}.navbar{background:#0f1728;border-bottom:1px solid var(--line)}.brand{font-weight:800;letter-spacing:.4px}.brand span{color:var(--green)}.panel,.stat{background:var(--panel);border:1px solid var(--line);border-radius:14px}.stat{padding:18px;height:100%}.stat .label{color:var(--muted);font-size:.78rem;text-transform:uppercase;letter-spacing:.08em}.stat .value{font-size:1.65rem;font-weight:750;margin-top:5px}.muted{color:var(--muted)}.table{--bs-table-bg:transparent;--bs-table-color:var(--text);--bs-table-border-color:var(--line);font-size:.86rem}.table thead th{color:var(--muted);font-weight:600;font-size:.72rem;text-transform:uppercase;white-space:nowrap}.pill{border:1px solid var(--line);border-radius:30px;padding:5px 10px;font-size:.75rem}.positive{color:var(--green)!important}.negative{color:var(--red)!important}.section-title{font-size:1rem;font-weight:700}.form-control,.form-select{background:#0b1324;border-color:var(--line);color:var(--text)}.btn-outline-light{border-color:var(--line)}.small-note{font-size:.75rem;color:var(--muted)}.table-responsive{max-height:440px}
</style>
</head>
<body>
<nav class="navbar navbar-dark px-3 px-lg-4 py-3"><div class="container-fluid"><div class="brand fs-5">POLY<span>EDGE</span> <span class="pill ms-2">PAPER TRADING</span></div><div class="d-flex gap-2 align-items-center"><span id="connection" class="pill">Connecting…</span><button id="toggleBtn" class="btn btn-sm btn-outline-light">Pause bot</button><button id="resetBtn" class="btn btn-sm btn-outline-danger">Reset $100</button></div></div></nav>
<main class="container-fluid px-3 px-lg-4 py-4">
<div class="d-flex justify-content-between align-items-center mb-3"><div><h4 class="mb-1">Trading overview</h4><div class="muted small">BTC · ETH · SOL / 5-minute markets · UTC timestamps</div></div><div class="small-note">Updated <span id="updated">—</span></div></div>
<div class="row g-3 mb-4">
<div class="col-6 col-xl-2"><div class="stat"><div class="label">Equity</div><div class="value" id="equity">$100.00</div><div class="small-note">Cash + open positions</div></div></div>
<div class="col-6 col-xl-2"><div class="stat"><div class="label">Cash balance</div><div class="value" id="cash">$100.00</div><div class="small-note">Available to trade</div></div></div>
<div class="col-6 col-xl-2"><div class="stat"><div class="label">Realized P&amp;L</div><div class="value" id="realized">$0.00</div><div class="small-note">Closed trades</div></div></div>
<div class="col-6 col-xl-2"><div class="stat"><div class="label">Unrealized P&amp;L</div><div class="value" id="unrealized">$0.00</div><div class="small-note">Open positions</div></div></div>
<div class="col-6 col-xl-2"><div class="stat"><div class="label">Win rate</div><div class="value" id="winrate">0.0%</div><div class="small-note"><span id="tradecount">0</span> completed trades</div></div></div>
<div class="col-6 col-xl-2"><div class="stat"><div class="label">Open positions</div><div class="value" id="positioncount">0</div><div class="small-note">Max 3 concurrent</div></div></div>
</div>
<div class="row g-3 mb-4"><div class="col-12 col-lg-4"><div class="panel p-3 h-100"><div class="section-title mb-3">Live underlying prices</div><div class="d-flex justify-content-between py-2 border-bottom" style="border-color:var(--line)!important"><span>BTC / USDT</span><strong id="btc">—</strong></div><div class="d-flex justify-content-between py-2 border-bottom" style="border-color:var(--line)!important"><span>ETH / USDT</span><strong id="eth">—</strong></div><div class="d-flex justify-content-between py-2"><span>SOL / USDT</span><strong id="sol">—</strong></div><div class="small-note mt-3">Binance public bookTicker WebSocket</div></div></div><div class="col-12 col-lg-8"><div class="panel p-3 h-100"><div class="section-title mb-2">Strategy configuration</div><div class="row g-3"><div class="col-6 col-md-3"><div class="small-note">Starting capital</div><strong>$100.00</strong></div><div class="col-6 col-md-3"><div class="small-note">Risk / trade</div><strong>$5.00</strong></div><div class="col-6 col-md-3"><div class="small-note">Take profit</div><strong>12%</strong></div><div class="col-6 col-md-3"><div class="small-note">Stop loss</div><strong>18%</strong></div></div><hr style="border-color:var(--line)"/><div class="small-note">V1 strategy: 12-second underlying momentum sample + Polymarket best ask/bid. These are experimental paper rules, not a proven profitable strategy. Market prices and paper fills are estimates.</div></div></div></div>
<div class="panel p-3 mb-4"><div class="d-flex justify-content-between align-items-center mb-2"><div class="section-title">Open paper positions</div><span class="pill">Live mark-to-bid</span></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Asset / market</th><th>Side</th><th>Entry</th><th>Mark</th><th>Shares</th><th>Invested</th><th>Unrealized P&amp;L</th><th>Opened (UTC)</th></tr></thead><tbody id="positions"><tr><td colspan="8" class="muted">No open positions</td></tr></tbody></table></div></div>
<div class="panel p-3 mb-4"><div class="d-flex justify-content-between align-items-center mb-2"><div class="section-title">Completed paper trades</div><span class="pill">Last 100</span></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Closed (UTC)</th><th>Asset / market</th><th>Side</th><th>Entry</th><th>Exit</th><th>Shares</th><th>Invested</th><th>Net P&amp;L</th><th>Exit reason</th></tr></thead><tbody id="trades"><tr><td colspan="9" class="muted">No completed trades yet</td></tr></tbody></table></div></div>
<div class="panel p-3"><div class="d-flex justify-content-between align-items-center mb-2"><div class="section-title">Tracked wallet activity</div><span class="pill">Reference only · not copied</span></div><div class="small-note mb-2">Observed public fills from the four research wallets. These do not affect the $100 paper account.</div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Time (UTC)</th><th>Wallet</th><th>Asset</th><th>Market</th><th>Side / outcome</th><th>Price</th><th>Size</th></tr></thead><tbody id="wallets"><tr><td colspan="7" class="muted">Waiting for wallet data…</td></tr></tbody></table></div></div>
<footer class="small-note py-4">PolyEdge V1 · Paper only · No private keys · No live order placement · Data may be delayed or incomplete.</footer>
</main>
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js"></script>
<script>
const money=v=>new Intl.NumberFormat('en-US',{style:'currency',currency:'USD'}).format(Number(v||0));
const pct=v=>(Number(v||0)).toFixed(2)+'%'; const cls=v=>Number(v)>=0?'positive':'negative';
const dt=v=>v?new Date(v).toLocaleTimeString('en-GB',{hour12:false,timeZone:'UTC'}):'—';
async function refresh(){try{const r=await fetch('/api/dashboard');if(!r.ok)throw new Error('API');const d=await r.json();
 document.getElementById('equity').textContent=money(d.equity);document.getElementById('cash').textContent=money(d.cashBalance);
 const rp=document.getElementById('realized');rp.textContent=money(d.realizedPnl);rp.className='value '+cls(d.realizedPnl);
 const up=document.getElementById('unrealized');up.textContent=money(d.unrealizedPnl);up.className='value '+cls(d.unrealizedPnl);
 document.getElementById('winrate').textContent=pct(d.winRate);document.getElementById('tradecount').textContent=d.totalTrades;document.getElementById('positioncount').textContent=d.openPositions.length;
 for(const a of ['BTC','ETH','SOL'])document.getElementById(a.toLowerCase()).textContent=d.prices[a]?Number(d.prices[a]).toLocaleString('en-US',{maximumFractionDigits:4}):'—';
 document.getElementById('positions').innerHTML=d.openPositions.length?d.openPositions.map(p=>`<tr><td><strong>${p.asset}</strong><div class="small-note">${escapeHtml(p.marketQuestion)}</div></td><td><span class="pill">${p.side}</span></td><td>${Number(p.entryPrice).toFixed(4)}</td><td>${Number(p.currentPrice).toFixed(4)}</td><td>${Number(p.shares).toFixed(4)}</td><td>${money(p.investedUsd)}</td><td class="${cls(p.unrealizedPnl)}">${money(p.unrealizedPnl)}</td><td>${dt(p.openedAtUtc)}</td></tr>`).join(''):'<tr><td colspan="8" class="muted">No open positions</td></tr>';
 document.getElementById('trades').innerHTML=d.recentTrades.length?d.recentTrades.map(t=>`<tr><td>${dt(t.closedAtUtc)}</td><td><strong>${t.asset}</strong><div class="small-note">${escapeHtml(t.marketQuestion)}</div></td><td>${t.side}</td><td>${Number(t.entryPrice).toFixed(4)}</td><td>${Number(t.exitPrice).toFixed(4)}</td><td>${Number(t.shares).toFixed(4)}</td><td>${money(t.investedUsd)}</td><td class="${cls(t.pnlUsd)}">${money(t.pnlUsd)} <span class="small-note">(${pct(t.pnlPct)})</span></td><td>${t.exitReason}</td></tr>`).join(''):'<tr><td colspan="9" class="muted">No completed trades yet</td></tr>';
 document.getElementById('updated').textContent=new Date().toLocaleTimeString();
 }catch(e){document.getElementById('connection').textContent='API offline';}}
function escapeHtml(s){return String(s||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
async function wallets(){try{const r=await fetch('/api/wallet-fills');const d=await r.json();document.getElementById('wallets').innerHTML=d.length?d.map(x=>`<tr><td>${dt(x.timestampUtc)}</td><td title="${x.wallet}">${x.wallet.slice(0,8)}…</td><td>${x.asset}</td><td>${escapeHtml(x.market)}</td><td>${x.side} / ${x.outcome}</td><td>${Number(x.price).toFixed(4)}</td><td>${Number(x.size).toFixed(2)}</td></tr>`).join(''):'<tr><td colspan="7" class="muted">No wallet fills collected yet</td></tr>';}catch{}}
document.getElementById('toggleBtn').onclick=async()=>{const r=await fetch('/api/trading/toggle',{method:'POST'});const d=await r.json();document.getElementById('toggleBtn').textContent=d.enabled?'Pause bot':'Resume bot';};
document.getElementById('resetBtn').onclick=async()=>{if(!confirm('Paper hesabını $100 başlangıç bakiyesine sıfırlamak ve tüm geçmiş kayıtları silmek istiyor musun?'))return;await fetch('/api/trading/reset',{method:'POST'});await refresh();};
const conn=new signalR.HubConnectionBuilder().withUrl('/hubs/dashboard').withAutomaticReconnect().build();conn.on('dashboardUpdated',refresh);conn.start().then(()=>document.getElementById('connection').textContent='Live').catch(()=>document.getElementById('connection').textContent='Polling');setInterval(refresh,4000);setInterval(wallets,30000);refresh();wallets();
</script>
</body></html>
